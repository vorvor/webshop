<?php

use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Ajax\AjaxResponse;
use Drupal\Core\Ajax\HtmlCommand;
use Drupal\field\FieldConfigInterface;
use Drupal\file\Entity\File;
use Drupal\image\Entity\ImageStyle;
use Drupal\node\NodeInterface;
use Drupal\paragraphs\Entity\Paragraph;
use Drupal\paragraphs\ParagraphInterface;
use Drupal\taxonomy\Entity\Term;
use Symfony\Component\HttpFoundation\Request;
use Drupal\file\Element\ManagedFile;

/**
 * Implements hook_form_alter().
 */
function w_image_editor_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  if ($form_id == 'node_order_form' || $form_id == 'node_order_edit_form') {
    $form['#attached']['library'][] = 'w_image_editor/global';

    $route_match = \Drupal::routeMatch();
    $nid = $route_match->getParameter('node');
    if ($nid instanceof NodeInterface) {
      $nid = $nid->id();
    }

    $nid = is_numeric($nid) ? (int) $nid : null;
    $product = \Drupal::entityTypeManager()->getStorage('node')->load($nid);
    $masterCode = $product->get('field_master_code')->getValue()[0]['value'];

    $printAreas = \Drupal::service('w_solo_api.get_print_areas')->getPrintArea($masterCode);
    dpm($printAreas);

    $printArea = $form_state->getUserInput()['print_area_controls']['field_print_area_select'];
    dpm('printarea' . $printArea);
    $items = array_filter(
      array_keys($form['field_image_placement']['widget']),
      'is_numeric'
    );

    $count = count($items);

    $addedImage = $form['field_image_placement']['widget'][0]['subform']['field_image']['widget']['selection'][0]['target_id'];


    $form['field_image_placement']['widget'][$count - 1]['#attributes'] = ['class' => ['hidden']];

    if (!is_null($printArea)) {
      $form['field_image_placement']['widget'][$count - 2]['subform']['field_print_position']['widget'][0]['value']['#value'] = $printArea;
    }

    for ($c = 0; $c < $count; $c++) {
      $form['field_image_placement']['widget'][$c]['subform']['field_print_position']['widget'][0]['#disabled'] = TRUE;
      if ($c == $count - 2) {
        dpm($c . 'last round');
        $form['field_image_placement']['widget'][$c]['subform']['field_image']['widget']['#suffix'] = $printArea;
      } else {
        $form['field_image_placement']['widget'][$c]['subform']['field_image']['widget']['#suffix'] = $form['field_image_placement']['widget'][$c]['subform']['field_print_position']['widget'][0]['value']['#default_value'];
      }

      dpm($c . 'A' . $form['field_image_placement']['widget'][$c]['subform']['field_print_position']['widget'][0]['value']['#value']);
      dpm($c . 'B' . $printArea);
    }

    $areas = [];
    foreach ($printAreas['printing_positions'] as $area) {
      $areas[$area['position_id']]= $area['position_id'];
    }

    $form['print_area_controls'] = [
      '#type' => 'container',
      '#weight' => 10,
      '#tree' => TRUE,
    ];

    $form['print_area_controls']['field_print_area_select'] = [
      '#title' => 'Print Area',
      '#type' => 'select',
      '#options' => $areas,
    ];
  }

  if ($form_id == 'node_order_edit_form') {
    $sides = ['front', 'back', 'side'];
    foreach ($sides as $side) {
      $form["field_image_placement_$side"]['widget'][0]['subform']['field_image']['widget']['image_editor'] = [
        '#type' => 'container',
        '#attributes' => [
          'class' => ['after-image-area'],
          'data-paragraph-image' => '1',
          'data-type' => $side,
        ],
        '#weight' => 1,

        'canvas_wrap' => [
          '#type' => 'container',
          '#attributes' => ['id' => "editor-canvas-$side"],
          'canvas' => [
            '#type' => 'html_tag',
            '#tag' => 'canvas',
            '#attributes' => [
              'id' => "editor-$side",
              'width' => 300,
              'height' => 300,
            ],
          ],
        ],
      ];
    }
  }
}

function w_image_editor_add_paragraph_submit(array &$form, FormStateInterface $form_state) {
  $paragraph_field = 'field_image_placement';
  $selected = $form_state->getValue(['print_area_controls', 'field_print_area']);

  $input = $form_state->getUserInput();
  $selected = $input['print_area_controls']['field_print_area_select'] ?? NULL;

  dpm($form_state->getValues());
  dpm($selected);
  dpm('ˆˆˆ');

  if (empty($selected)) {
    $form_state->setRebuild(TRUE);
    return;
  }

  /** @var \Drupal\node\NodeInterface $node */
  $node = $form_state->getFormObject()->getEntity();

  // Create the paragraph of the correct bundle (machine name).
  $p = Paragraph::create([
    'type' => 'image_placement_wrapper',
    'field_print_position' => $selected,
  ]);

  // Append it to the node field.
  $node->get($paragraph_field)->appendItem($p);


  // Important: rebuild so the widget shows the new delta.
  $form_state->setRebuild(TRUE);
}

function w_image_editor_add_paragraph_ajax(array &$form, FormStateInterface $form_state) {
  // Return the paragraphs field element (wrapped).
  return $form['field_image_placement'];
}

/**
 * After-build callback for managed_file elements.
 *
 * Runs after ManagedFile::processManagedFile(), so upload_button exists here.
 */
function w_image_editor_managed_file_after_build(array $element, FormStateInterface $form_state) {

  \Drupal::logger('w_image_editor')->notice('after_build: keys=@keys type=@type', [
    '@keys' => implode(',', array_keys($element)),
    '@type' => $element['#type'] ?? 'n/a',
  ]);

  if (!isset($element['upload_button']['#ajax'])) {
    // If it's not showing up, this isn't the classic managed_file upload UI
    // (e.g. Media Library widget), or it's configured differently.
    return $element;
  }

  // Override the AJAX callback.
  $element['upload_button']['#ajax']['callback'] = 'w_image_editor_managed_file_upload_callback';

  // Pass our target selector through.
  $element['upload_button']['#ajax']['w_image_editor_target_selector'] = $element['#w_image_editor_target_selector'] ?? NULL;

  return $element;
}

function w_image_editor_managed_file_upload_callback(array &$form, FormStateInterface $form_state, Request $request) {
  // Let core handle the upload + widget refresh.
  $response = ManagedFile::uploadAjaxCallback($form, $form_state, $request);

  // Add our custom markup update.
  $trigger = $form_state->getTriggeringElement();
  $target = $trigger['#ajax']['w_image_editor_target_selector'] ?? NULL;

  if ($target) {
    $markup = '<div class="messages messages--status">✅ Image uploaded!</div>';
    $response->addCommand(new HtmlCommand($target, $markup));
  }

  return $response;
}

function w_image_editor_preprocess_field(array &$variables): void {
  // Only act on the paragraph image field you care about.
  if (
    ($variables['element']['#entity_type'] ?? NULL) === 'paragraph' &&
    ($variables['element']['#field_name'] ?? NULL) === 'field_image'
  ) {
    // If field has values, add a div after each rendered item.
    if (!empty($variables['items'])) {
      foreach ($variables['items'] as $delta => &$item) {
        // Append markup after the image render array.
        $item['content']['#suffix'] = ($item['content']['#suffix'] ?? '')
          . '<div class="after-image-area" data-delta="' . $delta . '"></div>';
      }
    }
  }
}

/*
 * Implements hook_theme_suggestions_HOOK_alter()
 */
function w_image_editor_theme_suggestions_fieldset_alter(array &$suggestions, array $variables) {
  $name = 'fieldset__' . $variables['element']['#parents'][0];
  $bundle = '';
  if (isset($variables['element']['#target_bundles'])) {
    $bundle = reset($variables['element']['#target_bundles']);
    $name .= '_' . $bundle;
  }

  $suggestions[] = $name;
}

/**
 * Implements hook_preprocess_node().
 */
function w_image_editor_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'order') {
    return;
  }

  // Only on the full node page.
  if (($variables['view_mode'] ?? '') !== 'full') {
    return;
  }

  $variables['#attached']['library'][] = 'w_image_editor/image-placement-product-page';
  $sides = ['front', 'back', 'side'];
  $style = '';
  foreach ($sides as $side) {
    $scale = $node->get("field_image_placement_$side")->entity->get('field_scale')->getValue()[0]['value'];
    $left = $node->get("field_image_placement_$side")->entity->get('field_left')->getValue()[0]['value'];
    $top = $node->get("field_image_placement_$side")->entity->get('field_top')->getValue()[0]['value'];
    $rotation = $node->get("field_image_placement_$side")->entity->get('field_rotation')->getValue()[0]['value'];

    $imagePalcement = $node->get("field_image_placement_$side")
      ->entity;
    $image = $imagePalcement->get('field_image')
      ->entity;

    if (!is_null($image)) {
      $image = $image->get('field_media_image')->getValue()[0];

      $file = File::load($image['target_id']);
      $dimensions = w_image_editor_get_styled_dimensions('media_library', $file);

      // Image positioning in fabric is by center of the image.
      $top = $top - ($dimensions['height'] * $scale / 2);
      $left = $left - ($dimensions['width'] * $scale / 2);

      $variables['#attributes'] = $variables['#attributes'] ?? [];
      $existing = $variables['#attributes']['style'] ?? '';
      $style .= trim($existing . ' ' . "--field-image-$side-scale: {$scale};");
      $style .= " --field-image-$side-left: {$left}px; --field-image-$side-top: {$top}px; --field-image-$side-rotation: {$rotation};";
      $variables['attributes']['style'] = $style;
    }
  }


}

function w_image_editor_get_styled_dimensions(string $style_name, File $file): ?array {
  $style = ImageStyle::load($style_name);
  if (!$style) {
    return NULL;
  }

  $uri = $file->getFileUri();

  // Read original dimensions.
  /** @var \Drupal\Core\Image\ImageFactory $image_factory */
  $image_factory = \Drupal::service('image.factory');
  $image = $image_factory->get($uri);
  if (!$image->isValid()) {
    return NULL;
  }

  $dimensions = [
    'width' => $image->getWidth(),
    'height' => $image->getHeight(),
  ];

  // Simulate the image style effects (incl. "upscale" behavior).
  $style->transformDimensions($dimensions, $uri);

  return $dimensions; // ['width' => ..., 'height' => ...]
}

/**
 * Implements hook_preprocess_paragraph().
 */
function w_image_editor_preprocess_paragraph(array &$variables): void {
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof ParagraphInterface) {
    return;
  }
  if ($paragraph->bundle() !== 'order_option') {
    return;
  }

  $bundle = 'order_option';
  $view_mode = $variables['view_mode'] ?? 'default';

  $display = EntityViewDisplay::load("paragraph.$bundle.$view_mode");
  $components = $display ? $display->getComponents() : [];

  $definitions = \Drupal::service('entity_field.manager')
    ->getFieldDefinitions('paragraph', $bundle);

  $rows = [];

  foreach ($definitions as $field_name => $definition) {
    if (!$definition instanceof FieldConfigInterface) {
      continue;
    }

    if (!isset($components[$field_name])) {
      continue;
    }

    if ($field_name === 'field_color' && !is_null($paragraph->get($field_name)->entity)) {

      $termId = \Drupal::entityQuery("taxonomy_term")
        ->condition("vid", "t_shirt_colors")
        ->condition("name", $paragraph->get($field_name)->entity->label())
        ->accessCheck()
        ->execute();

      $colorTerm = Term::load(reset($termId));
      $colorCode = $colorTerm->get('field_color_hex')->value ?? '';

      $color = [
        'name' => $field_name,
        'colorCode' => $colorCode,
        'weight' => (int)($components[$field_name]['weight'] ?? 0),
        'label' => $definition->getLabel(),
        'value' => $paragraph->get($field_name)->entity->label(),
      ];
    }

    if (str_contains($field_name, 'amount')) {
      $has_value = !$paragraph->get($field_name)->isEmpty();
      $rows[] = [
        'name' => $field_name,
        'weight' => (int)($components[$field_name]['weight'] ?? 0),
        'label' => $definition->getLabel(),
        'has_value' => $has_value,
        'value' => $has_value ? $paragraph->get($field_name)->view(['label' => 'hidden']) : NULL,
      ];
    }
  }

  usort($rows, fn($a, $b) => $a['weight'] <=> $b['weight']);

  // Preserve order for Twig iteration.
  $ordered = [];
  foreach ($rows as $r) {
    $ordered[$r['name']] = $r;
  }

  $variables['color'] = $color ?? NULL;
  $variables['order_fields'] = $ordered;
}
